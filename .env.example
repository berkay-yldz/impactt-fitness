# =========================================
# IMPACT FITNESS - ENV ISKELETI
# =========================================
# Bu dosya repoda kalir (sablon).
# Gercek anahtarlari kopyalayip `.env` adiyla kaydet.
# `.env` dosyasi .gitignore icinde, asla commit edilmez.
# =========================================

# --- Firebase Client SDK (Frontend / Vite) ---
# Firebase Console > Project Settings > General > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Firebase Admin SDK (Backend / api/ Serverless) ---
# Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Vercel Cron Auth ---
# Cron endpoint'lerini disaridan korumak icin rastgele bir string uret
# Ornek: openssl rand -hex 32
CRON_SECRET=

GEMINI_API_KEY=
RESEND_API_KEY=
